				"support.type.sys-types"
			],
			"settings": {
				"foreground": "#72F2D5"
			}
		},
		{
			"name": "Entity Types",
			"scope": [
				"support.type"
			],
			"settings": {
				"foreground": "#72F2D5"
			}
		},
		{
			"name": "CSS Class and Support",
